{
  "manifest_version": 3,
  "name": "HF 中文",
  "version": "0.3.0",
  "description": "中文化 Hugging Face 与 hf-mirror.com 界面，支持 AI 翻译模型卡 README",
  "permissions": ["storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://huggingface.co/*",
        "https://hf-mirror.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    { "resources": ["dict.json"], "matches": ["https://huggingface.co/*", "https://hf-mirror.com/*"] }
  ],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*",
    "https://raw.githubusercontent.com/*",
    "https://api.deepseek.com/*",
    "https://open.bigmodel.cn/*",
    "https://dashscope.aliyuncs.com/*",
    "https://openrouter.ai/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
